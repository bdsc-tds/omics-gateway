[Unit]
Description=CellxGene Gateway
After=network.target

[Service]
Type=simple
# Host-specific: account owning clone.
User=CHANGEME_USER
# Host-specific: repository root.
WorkingDirectory=/path/to/omics-gateway

# Start command
ExecStart=/path/to/omics-gateway/start_gunicorn.sh

# Restart conditions
Restart=on-failure
RestartSec=10

# Logging
# deploy/setup.sh creates logs/; append: fails if directory is missing.
StandardOutput=append:/path/to/omics-gateway/logs/omics-gateway.log
StandardError=append:/path/to/omics-gateway/logs/omics-gateway.log

# start_gunicorn.sh settings are ${VAR:-default}, so override them here, e.g.:
# Environment=CONDA_ROOT=/opt/miniforge3
# Environment=CELLXGENE_DATA=/mnt/cellxgene_data

[Install]
WantedBy=multi-user.target
